# Run with: op run --env-file=.env.1password -- <command>
# Copy this file to .env.1password; the copy is ignored by `.env.*`.
# Any source can reference its own PREFIX_ACCESS_KEY/PREFIX_SECRET_KEY pair;
# these legacy MEGA names are retained for the existing Titles bucket.
MEGA_ACCESS_KEY=op://Olympus/Mega S3 Bucket/Access Key
MEGA_SECRET_KEY=op://Olympus/Mega S3 Bucket/Secret Key
FAL_KEY=op://Olympus/FAL API KEY titles-LoRA/credential

# Optional authenticated loopback-tunnel access. Configure all three together.
TITLES_REMOTE_ACCESS_ORIGIN=https://modelfiche.example.com
TITLES_REMOTE_ACCESS_CLIENT_ID=op://Olympus/Modelfiche Remote Access/client-id
TITLES_REMOTE_ACCESS_CLIENT_SECRET=op://Olympus/Modelfiche Remote Access/client-secret

# Optional externally reachable W&B compatibility origin.
TITLES_WANDB_INGRESS_BASE_URL=https://wandb.example.com
