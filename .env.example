TITLES_API_URL=http://127.0.0.1:8400
TITLES_DATABASE_URL=sqlite:///./var/titles-dam.sqlite3
TITLES_ASSET_ROOT=./var/assets
TITLES_CACHE_ROOT=./var/cache
TITLES_EXPORT_ROOT=./var/exports

# Standard AWS S3: leave S3_ENDPOINT empty and boto3 will use AWS defaults.
# For S3-compatible providers, set S3_ENDPOINT and optionally path addressing.
S3_ENDPOINT=
S3_REGION=
S3_ADDRESSING_STYLE=auto
S3_BUCKET=
S3_ALLOWED_PREFIXES=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Legacy MEGA names remain supported and can seed a second S3 source.
# MEGA_ENDPOINT=https://s3.g.s4.mega.io
# MEGA_REGION=eu-central-1
# MEGA_ADDRESSING_STYLE=auto
# MEGA_BUCKET=titlesxyz
# MEGA_ALLOWED_PREFIXES=title-lora/datasets/,title-lora/projects/
# MEGA_ACCESS_KEY=
# MEGA_SECRET_KEY=

FAL_KEY=

# Prompt-set generation reads one provider key at request time. Keys are never
# stored in the application database or returned by the settings API.
LLM_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
